PORT=4001
MONGO_USER=user
MONGO_PASSWORD=pass
MONGO_PORT=27017
MONGO_URI=mongodb://user:pass@localhost:27017/yenshow?directConnection=true&authSource=admin
JWT_SECRET=
CORS_ORIGIN=http://localhost:3002,https://www.yenshow.com,https://liff.yenshow.com
NODE_ENV=development
HOST=0.0.0.0
FILES_ROOT=D:\\storage

# 公開 URL（官網 canonical / sitemap、產品圖 /storage 絕對路徑）
PUBLIC_SITE_URL=https://www.yenshow.com
PUBLIC_BASE_URL=http://localhost:4001

# 離線授權簽名密鑰（HMAC-SHA256）
LICENSE_SIGN_SECRET=

# 雲端API設定 (與 yenshow 匹配)
API_KEY=

# 站點地圖構建密鑰（與官網 frontend .env 一致）
SITEMAP_BUILD_SECRET=

# --- Yenshow 設定 ---
YENSHOW_CLOUDFLARE_TUNNEL_TOKEN=
YENSHOW_RESEND_API_KEY=
YENSHOW_EMAIL_FROM_ADDRESS_RESEND=noreply@yenshow.com
YENSHOW_EMAIL_FROM_NAME_RESEND="Yenshow 聯絡表單"
YENSHOW_CONTACT_EMAIL_RECIPIENT=
YENSHOW_CONTACT_EMAIL_CC=
YENSHOW_LINE_CHANNEL_SECRET=
YENSHOW_LINE_CHANNEL_ACCESS_TOKEN=
YENSHOW_GA_MEASUREMENT_ID=
YENSHOW_GA_API_SECRET=

# --- Comeo 設定 ---
COMEO_CLOUDFLARE_TUNNEL_TOKEN=
COMEO_RESEND_API_KEY=
COMEO_EMAIL_FROM_ADDRESS_RESEND=noreply@comeo.com
COMEO_EMAIL_FROM_NAME_RESEND="Comeo 聯絡表單"
COMEO_CONTACT_EMAIL_RECIPIENT=
COMEO_CONTACT_EMAIL_CC=
COMEO_GA_MEASUREMENT_ID=
COMEO_GA_API_SECRET=

# --- 授權審核 Email 通知 ---
YENSHOW_LICENSE_NOTIFY_EMAILS=
YENSHOW_ADMIN_APP_URL=http://localhost:3002

# --- Customer Hub / LIFF ---
LINE_LOGIN_CHANNEL_ID=
HUB_USE_MOCK=true
CRM_HUB_SUB_HASH_SECRET=
